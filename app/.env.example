# The app builds and serves with ZERO env vars set. Both variables below are
# entirely optional and only gate the "live LLM" persona demo feature (see
# app/src/app/api/persona-live/route.ts); the report and scenario explorer
# read only the static app/src/data/*.json artifacts committed by
# `make export` and need no env vars at all.

# Optional: enables the "Live LLM" button/route (components/report/
# PersonaCards.tsx, app/src/app/api/persona-live/route.ts). When unset (or
# not exactly "true"), the button is hidden and the route returns 501 --
# the report still shows the pre-generated persona pass (app/src/data/
# personas.json, when `make personas` has been run) either way.
ENABLE_LIVE_LLM=false

# Optional: only read when ENABLE_LIVE_LLM=true. Without it, the live-LLM
# route still returns a clean 501 explaining a key is missing, rather than
# erroring. Never commit a real key here.
OPENAI_API_KEY=
